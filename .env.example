# Copy to .env and adjust. All variables are optional. Out of the box the
# crawler runs with ZERO external services: an embedded SQLite database, an
# in-memory frontier, and in-process rate limiting / dedup. Uncomment the
# Postgres/Redis/Kafka lines only when scaling out to the distributed worker
# fleet (which you would install natively or via a managed service).

# CRAWLER_BASE_URL=http://localhost:8010
# CRAWLER_LOG_LEVEL=INFO
# CRAWLER_LOG_JSON=false

# --- Default: embedded SQLite (no services required) ---
# CRAWLER_POSTGRES__DSN=sqlite+aiosqlite:///./crawler.db

# --- Scale-out: point at natively-installed / managed services ---
# CRAWLER_POSTGRES__DSN=postgresql+asyncpg://crawler:crawler@localhost:5432/crawler
# CRAWLER_REDIS__URL=redis://localhost:6379/0
# CRAWLER_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
# CRAWLER_FRONTIER__BACKEND=kafka   # default "memory"

# CRAWLER_FETCH__CONCURRENCY=100
# CRAWLER_FETCH__PER_HOST_CONCURRENCY=2
# CRAWLER_FETCH__USER_AGENT=MoonshotCrawler/0.1 (+https://github.com/moonshot/web-crawler)

# CRAWLER_POLITENESS__RESPECT_ROBOTS=true
# CRAWLER_POLITENESS__DEFAULT_CRAWL_DELAY_MS=1000

# CRAWLER_CRAWL__MAX_DEPTH=3
# CRAWLER_CRAWL__MAX_PAGES=1000

# CRAWLER_STORAGE__BODY_BACKEND=postgres   # inline bodies; or "minio"
# CRAWLER_STORAGE__MINIO_ENDPOINT=localhost:9000
